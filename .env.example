# --- Database (Supabase: Project Settings > Database > Connection string, "Session pooler" or direct) ---
# Local docker-compose default shown. Use the Session pooler (port 5432) on Supabase; transaction pooler also works.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlesprint

# --- Celery broker ---
REDIS_URL=redis://localhost:6379/0

# --- LLM / embeddings ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
ANTHROPIC_API_KEY=            # used from Phase 2 onwards

# --- Scraping etiquette: put a real contact in the UA ---
USER_AGENT=MLE-Sprint/0.1 (personal research aggregator; contact: you@example.com)

# --- Optional: Reddit official API (reddit.com/prefs/apps -> "script" or "web app"). Reddit sources are skipped without it,
#     because reddit.com/robots.txt disallows generic crawlers. ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Tuning ---
DEDUP_THRESHOLD=0.92          # cosine similarity above which two articles are "the same story"
