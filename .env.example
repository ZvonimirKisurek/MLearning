# =====================================================================================================================
# Backend environment (FastAPI + Celery). Locally: copy to .env. In production these are set in the host dashboards
# (Render env vars / render.yaml), NEVER committed. Frontend (Vercel) variables are listed at the bottom.
# =====================================================================================================================

# --- Database: Supabase Postgres + pgvector ---------------------------------------------------------------------------
# Supabase dashboard > Connect > "Session pooler" (port 5432, user postgres.<project-ref>). Use the SESSION pooler in
# production: it is IPv4-reachable (the direct db.<ref>.supabase.co host is IPv6-only) and keeps session state.
# Append ?sslmode=require. URL-encode special characters in the password (@ -> %40, / -> %2F).
# Local docker-compose default shown.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlesprint
# Production example:
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Redis: Celery broker (Upstash in production) -----------------------------------------------------------------------
# Upstash console > your database > "Connect" > copy the TLS URL: it starts with rediss:// (two s = TLS). Celery is
# configured to enforce certificate validation automatically for rediss:// (see app/celery_app.py).
REDIS_URL=redis://localhost:6379/0
# Production example:
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-name-12345.upstash.io:6379

# --- LLM / embeddings ---------------------------------------------------------------------------------------------------
OPENAI_API_KEY=               # the ONLY provider key: embeddings, summaries, generators, grader
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o              # needs Structured Outputs (gpt-4o-2024-08-06 or later)
SUMMARY_MODEL=gpt-4o-mini
LLM_DAILY_BUDGET_USD=1.00     # hard in-app cap on estimated LLM spend per rolling 24 h (typical use ~$0.15/day)

# --- Schedule / curriculum ----------------------------------------------------------------------------------------------
TIMEZONE=UTC                  # IANA name, e.g. Europe/Zagreb. Sets "today" AND the 06:30 daily / Sunday 22:00 Celery Beat times
ROADMAP_START=                # YYYY-MM-DD of the MONDAY you start the 4-week roadmap; empty = no roadmap

# --- API (FastAPI) ------------------------------------------------------------------------------------------------------
API_TOKEN=                    # shared secret. Must equal Vercel's API_TOKEN. Generate: openssl rand -hex 32. Empty = API open (dev only!)
FRONTEND_URL=                 # production Vercel origin, e.g. https://mle-sprint.vercel.app (no trailing slash); added to CORS
CORS_ORIGINS=http://localhost:3000   # extra comma-separated origins (local dev). The browser normally never calls the API directly
ENABLE_DOCS=true              # set false in production (hides /docs and /openapi.json); the Docker image already defaults to false

# --- Background jobs ----------------------------------------------------------------------------------------------------
TASK_BACKEND=celery           # celery = Redis + worker. inline = run jobs in the API process (no Redis; pair with GitHub Actions cron)

# --- Scraping etiquette: put a real contact in the UA -------------------------------------------------------------------
USER_AGENT=MLE-Sprint/0.1 (personal research aggregator; contact: you@example.com)

# --- Optional: Reddit official API (reddit.com/prefs/apps). Reddit sources are skipped without it. ----------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Tuning -------------------------------------------------------------------------------------------------------------
DEDUP_THRESHOLD=0.92          # cosine similarity above which two articles are "the same story"
MATCH_STRONG=0.40             # feed badge thresholds; calibrate with: python -m app.cli calibrate
MATCH_MODERATE=0.28
RETENTION_DAYS=60             # articles older than this are pruned weekly (keeps a free-tier database small)

# =====================================================================================================================
# FRONTEND (Vercel, Root Directory = frontend/). These are NOT read from this file: set them in Vercel > Settings >
# Environment Variables (Production). frontend/.env.example documents the same set for local dev.
# =====================================================================================================================
# API_URL=https://mle-sprint-api.onrender.com   # your Render web service URL, https, no trailing slash. Server-side only
# API_TOKEN=<same value as the backend's API_TOKEN>
# BASIC_AUTH_USER=<choose>                      # HTTP Basic gate over the whole site (frontend/src/proxy.ts).
# BASIC_AUTH_PASSWORD=<long random password>    # If either is unset the gate is OFF, so set BOTH in Production.
